# Copy to .env.local for local development. Never commit real values.

# --- Client (exposed to the browser; safe to be public) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (sb_publishable_...) or legacy anon key.
VITE_SUPABASE_ANON_KEY=your-publishable-key

# --- Server only (the /api functions; never prefix with VITE_) ---
OPENAI_API_KEY=sk-...
# The spending caps in server/generateCourse.ts are sized for gpt-5.4-nano prices.
OPENAI_MODEL=gpt-5.4-nano
# Supabase secret key (sb_secret_...) or legacy service_role key. Required: the spending
# caps live in the database, and without it the server refuses to call OpenAI.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
