# Copy to .env.local for local development. Never commit real values.

# --- Client (exposed to the browser; safe to be public) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (sb_publishable_...) or legacy anon key.
VITE_SUPABASE_ANON_KEY=your-publishable-key

# --- Server only (the /api functions; never prefix with VITE_) ---
OPENAI_API_KEY=sk-...
# Any model that supports Structured Outputs. A fast one keeps generation under the 15 s limit.
OPENAI_MODEL=
# Supabase secret key (sb_secret_...) or legacy service_role key. Without it, AI courses
# still generate but get no share code, and the rate limit falls back to per-instance memory.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
